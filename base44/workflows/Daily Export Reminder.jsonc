  "name": "Daily Export Reminder",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_export_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "daily-sales-export",
            "args": {
              "action": "reminder"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Smena eslatmasi",
            "description": "Yopilmagan smenalar uchun Telegram"
          }
        }
      }
    ]
  },
  "description": "01:00 Tashkent \u2014 hali yopilmagan smenalar uchun Telegram eslatma yuboradi."
