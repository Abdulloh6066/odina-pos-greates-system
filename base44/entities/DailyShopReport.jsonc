{
  "name": "DailyShopReport",
  "type": "object",
  "properties": {
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "Asia/Tashkent bo'yicha savdo kuni (YYYY-MM-DD)"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Sotilgan mahsulot tannarxi"
    },
    "real_profit": {
      "type": "number",
      "default": 0,
      "description": "Tushum - tannarx"
    },
    "sale_count": {
      "type": "number",
      "default": 0
    },
    "refund_count": {
      "type": "number",
      "default": 0
    },
    "cash_total": {
      "type": "number",
      "default": 0
    },
    "uzcard_total": {
      "type": "number",
      "default": 0
    },
    "humo_total": {
      "type": "number",
      "default": 0
    },
    "online_total": {
      "type": "number",
      "default": 0
    },
    "bank_transfer_total": {
      "type": "number",
      "default": 0
    },
    "sheet_appended": {
      "type": "boolean",
      "default": false
    },
    "sheet_append_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_by_id": {
      "type": "string"
    },
    "sent_by_name": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "shift_close"
      ],
      "default": "manual"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "order_payment_total": {
      "type": "number"
    },
    "collections_total": {
      "type": "number"
    },
    "expenses_total": {
      "type": "number"
    },
    "net_profit": {
      "type": "number"
    },
    "unknown_cost_count": {
      "type": "number"
    },
    "delivery_fingerprint": {
      "type": "string"
    },
    "sheet_fingerprint": {
      "type": "string"
    },
    "email_fingerprint": {
      "type": "string"
    },
    "email_delivery_state": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "sent",
        "failed",
        "uncertain"
      ]
    },
    "email_recipient_snapshot": {
      "type": "string"
    },
    "email_attempted_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_attempted_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_error": {
      "type": "string"
    }
  },
  "required": [
    "business_date",
    "shop_id",
    "shop_name",
    "total_revenue",
    "total_cost",
    "real_profit"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$nor": [
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "accountant"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "manager",
                "active": true
              }
            },
            {
              "data.shop_id": {
                "$nin": [
                  "",
                  null
                ]
              }
            },
            {
              "data.shop_id": "{{user.data.shop_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
