{
  "properties": {
    "cashier_id": {
      "type": "string"
    },
    "cashier_name": {
      "type": "string"
    },
    "closed_at": {
      "format": "date-time",
      "type": "string"
    },
    "counted_by_id": {
      "type": "string"
    },
    "counted_by_name": {
      "type": "string"
    },
    "counted_quantity": {
      "default": 0,
      "type": "number"
    },
    "difference": {
      "default": 0,
      "type": "number"
    },
    "expected_quantity": {
      "default": 0,
      "type": "number"
    },
    "image_url_snapshot": {
      "type": "string"
    },
    "opening_quantity": {
      "default": 0,
      "type": "number"
    },
    "other_change_quantity": {
      "default": 0,
      "type": "number"
    },
    "product_id": {
      "type": "string"
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "received_quantity": {
      "default": 0,
      "type": "number"
    },
    "returned_quantity": {
      "default": 0,
      "type": "number"
    },
    "shift_id": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "sold_quantity": {
      "default": 0,
      "type": "number"
    },
    "unit": {
      "default": "piece",
      "enum": [
        "piece"
      ],
      "type": "string"
    },
    "waste_quantity": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "shift_id",
    "shop_id",
    "cashier_id",
    "product_id",
    "product_name_snapshot",
    "unit",
    "expected_quantity",
    "counted_quantity",
    "difference",
    "closed_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false,
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "data.cashier_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": false
  },
  "type": "object",
  "name": "ShiftProductSnapshot"
}
