{
  "name": "Shift",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closing",
        "closed"
      ],
      "default": "open"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "starting_cash": {
      "type": "number",
      "default": 0
    },
    "expected_cash": {
      "type": "number",
      "default": 0
    },
    "actual_cash": {
      "type": "number",
      "default": 0
    },
    "difference": {
      "type": "number",
      "default": 0
    },
    "cash_sales": {
      "type": "number",
      "default": 0
    },
    "uzcard_sales": {
      "type": "number",
      "default": 0
    },
    "humo_sales": {
      "type": "number",
      "default": 0
    },
    "online_sales": {
      "type": "number",
      "default": 0
    },
    "bank_transfer_sales": {
      "type": "number",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "order_count": {
      "type": "number",
      "default": 0
    },
    "sale_request_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cash_removed": {
      "type": "number",
      "default": 0
    },
    "refunds_total": {
      "type": "number",
      "default": 0
    },
    "stock_count_completed": {
      "type": "boolean",
      "default": false
    },
    "stock_snapshot_count": {
      "type": "number",
      "default": 0
    },
    "stock_difference_quantity": {
      "type": "number",
      "default": 0
    },
    "stock_difference_product_count": {
      "type": "number",
      "default": 0
    },
    "budget_settled": {
      "type": "boolean",
      "default": false
    },
    "budget_settlement_reference": {
      "type": "string"
    },
    "budget_cash_submitted": {
      "type": "number",
      "default": 0
    },
    "cash_left_for_next_shift": {
      "type": "number",
      "default": 0
    },
    "budget_settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_settled_by_id": {
      "type": "string"
    },
    "budget_settled_by_name": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "shop_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$nor": [
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "accountant"
                  }
                },
                {
                  "data.user_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "manager",
                "active": true
              }
            },
            {
              "data.shop_id": {
                "$nin": [
                  "",
                  null
                ]
              }
            },
            {
              "data.shop_id": "{{user.data.shop_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
