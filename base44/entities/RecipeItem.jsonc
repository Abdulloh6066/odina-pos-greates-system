{
  "name": "RecipeItem",
  "type": "object",
  "properties": {
    "recipe_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "ingredient_id": {
      "type": "string"
    },
    "ingredient_name_snapshot": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "g",
        "ml",
        "piece"
      ]
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "recipe_id",
    "product_id",
    "ingredient_id",
    "ingredient_name_snapshot",
    "quantity",
    "unit"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}