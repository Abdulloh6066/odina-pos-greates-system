{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string"
    },
    "financial_records_version": {
      "type": "number",
      "default": 2
    },
    "sale_items_count": {
      "type": "number",
      "default": 0
    },
    "shift_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "stock_tracked": {
            "type": "boolean"
          },
          "stock_location_id": {
            "type": "string"
          },
          "stock_quantity_change": {
            "type": "number"
          },
          "product_name": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "payment_methods_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "refunded"
      ],
      "default": "completed"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time"
    },
    "refunded_by": {
      "type": "string"
    },
    "refund_id": {
      "type": "string"
    },
    "refund_reason": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "user_id",
    "shop_id",
    "subtotal",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}