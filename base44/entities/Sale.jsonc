{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string"
    },
    "service_ticket_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Oshxona xizmat chekining savdo paytida saqlangan do\u2018kon bo\u2018yicha raqami; asl sale_number o\u2018zgarmaydi"
    },
    "is_delivery": {
      "type": "boolean",
      "default": false,
      "description": "Savdo dostavka uchun belgilangan; qo‘shimcha haq yoki manzil talab qilmaydi"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 128,
      "description": "Kassa so\u2018rovini takroran yozishni oldini oladigan qurilma kaliti"
    },
    "request_fingerprint": {
      "type": "string",
      "description": "Idempotency kalitiga bog\u2018langan server hisoblagan so\u2018rov izi"
    },
    "sold_at": {
      "type": "string",
      "format": "date-time",
      "description": "Savdo kassada amalga oshirilgan vaqt"
    },
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "Asia/Tashkent bo\u2018yicha savdo kuni"
    },
    "financial_records_version": {
      "type": "number",
      "default": 2
    },
    "sale_items_count": {
      "type": "number",
      "default": 0
    },
    "shift_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "table_order_id_snapshot": {
      "type": "string",
      "description": "To\u2018langan stol buyurtmasining o\u2018zgarmas identifikatori"
    },
    "table_order_revision_snapshot": {
      "type": "integer",
      "minimum": 1,
      "description": "To\u2018lov paytidagi stol buyurtmasi versiyasi"
    },
    "table_number_snapshot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Kassadan savdo yakunlangan vaqtdagi restoran stoli; keyin o\u2018zgartirilmaydi"
    },
    "receipt_instagram_snapshot": {
      "type": "string",
      "description": "Savdo paytidagi do\u2018kon Instagram username; keyingi sozlama o\u2018zgarishlaridan mustaqil"
    },
    "receipt_phone_snapshot": {
      "type": "string",
      "description": "Savdo paytidagi do\u2018kon telefon raqami"
    },
    "receipt_address_snapshot": {
      "type": "string",
      "description": "Savdo paytidagi do\u2018kon manzili"
    },
    "customer_id": {
      "type": "string",
      "description": "Bog'langan mijoz (Customer) yozuvi IDsi"
    },
    "customer_name_snapshot": {
      "type": "string"
    },
    "customer_phone_snapshot": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "stock_tracked": {
            "type": "boolean"
          },
          "stock_location_id": {
            "type": "string"
          },
          "stock_quantity_change": {
            "type": "number"
          },
          "product_name": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "sale_unit": {
            "type": "string",
            "enum": [
              "piece",
              "gram"
            ],
            "default": "piece"
          },
          "fries_option": {
            "type": "string",
            "enum": [
              "with",
              "without"
            ],
            "description": "Burger fri tanlovi; eski savdolarda bo\u2018sh qoladi"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "payment_methods_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "refunded"
      ],
      "default": "completed"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time"
    },
    "refunded_by": {
      "type": "string"
    },
    "refund_id": {
      "type": "string"
    },
    "refund_reason": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "user_id",
    "shop_id",
    "subtotal",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "data.user_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}