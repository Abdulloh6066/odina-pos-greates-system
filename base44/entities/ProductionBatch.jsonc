{
  "name": "ProductionBatch",
  "type": "object",
  "properties": {
    "batch_number": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number_snapshot": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "output_disposition": {
      "type": "string",
      "enum": [
        "stock",
        "customer_order"
      ],
      "default": "stock"
    },
    "reserved_pieces": {
      "type": "number",
      "default": 0
    },
    "recipe_id": {
      "type": "string"
    },
    "recipe_version": {
      "type": "integer"
    },
    "recipe_output_quantity": {
      "type": "number"
    },
    "produced_quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "piece",
        "sheet"
      ],
      "default": "piece"
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "description": "1 natija birligi (dona/varaq) tannarxi — ishlab chiqarish yakunida saqlanadi"
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Butun partiya tannarxi = unit_cost * produced_quantity"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "cancelled"
      ],
      "default": "processing"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "batch_number",
    "location_id",
    "product_id",
    "product_name_snapshot",
    "recipe_id",
    "produced_quantity",
    "unit",
    "status",
    "created_at",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$nor": [
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "accountant"
                  }
                },
                {
                  "data.location_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "manager",
                "active": true
              }
            },
            {
              "data.location_id": {
                "$nin": [
                  "",
                  null
                ]
              }
            },
            {
              "data.location_id": "{{user.data.shop_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
