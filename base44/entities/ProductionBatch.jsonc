{
  "name": "ProductionBatch",
  "type": "object",
  "properties": {
    "batch_number": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "recipe_id": {
      "type": "string"
    },
    "recipe_version": {
      "type": "integer"
    },
    "recipe_output_quantity": {
      "type": "number"
    },
    "produced_quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "piece"
      ],
      "default": "piece"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "cancelled"
      ],
      "default": "processing"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "batch_number",
    "location_id",
    "product_id",
    "product_name_snapshot",
    "recipe_id",
    "produced_quantity",
    "unit",
    "status",
    "created_at",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "data.location_id": "{{user.data.shop_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}