{
  "name": "Refund",
  "type": "object",
  "properties": {
    "refund_number": {
      "type": "string"
    },
    "sale_id": {
      "type": "string"
    },
    "sale_number": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "cashier_id": {
      "type": "string"
    },
    "cashier_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "payment_summary": {
      "type": "string"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sale_id",
    "shop_id",
    "shift_id",
    "cashier_id",
    "amount",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "data.cashier_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
