{
  "name": "Shop",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "address": {
      "type": "string"
    },
    "allows_pos": {
      "default": true,
      "type": "boolean"
    },
    "is_main": {
      "default": false,
      "type": "boolean"
    },
    "location_type": {
      "default": "shop",
      "enum": [
        "shop",
        "production"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "service_ticket_counter": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Do\u2018konning joriy smenalar davridagi oshxona xizmat cheki raqami; savdo ID emas"
    },
    "service_ticket_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Ikki kassir bir xil xizmat raqamini olmasligi uchun atomik versiya"
    },
    "service_ticket_cycle_active": {
      "type": "boolean",
      "default": false,
      "description": "Shu do\u2018konda smenalar davri davom etmoqda; barcha smenalar yopilsa false"
    },
    "restaurant_table_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "default": 0,
      "description": "Stollar soni: 0 = hali sozlanmagan yoki o\u2018chirilgan"
    },
    "restaurant_entrance": {
      "type": "object",
      "description": "Do\u2018kon zalidagi kirish eshigi: devor va devor bo\u2018ylab 0\u20131000 koordinata",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 150,
          "maximum": 850
        }
      },
      "required": [
        "side",
        "offset"
      ],
      "default": {
        "side": "top",
        "offset": 500
      }
    },
    "restaurant_table_orders_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Stollar bo\u2018yicha to\u2018lanmagan buyurtmalarni bir vaqtda tahrirlash nazorati"
    },
    "restaurant_table_groups": {
      "type": "array",
      "description": "Birga o\u2018tirgan mehmonlar uchun vaqtincha birlashtirilgan stollar; hisob yopilganda guruh avtomatik yechiladi",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "numbers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "numbers",
          "created_at",
          "created_by"
        ]
      },
      "default": []
    },
    "restaurant_table_orders": {
      "type": "array",
      "description": "Do\u2018konning ochiq stol buyurtmalari; to\u2018lovgacha savdo yoki ombor harakati emas",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "ticket_number": {
            "type": "integer",
            "minimum": 1,
            "description": "Stol buyurtmasi birinchi saqlanganda berilgan do\u2018kon bo\u2018yicha xizmat raqami"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "occupied",
              "paying"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string"
                },
                "product_name": {
                  "type": "string"
                },
                "image_url": {
                  "type": "string"
                },
                "price": {
                  "type": "number",
                  "minimum": 0
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "subtotal": {
                  "type": "number",
                  "minimum": 0
                },
                "stock_tracked": {
                  "type": "boolean"
                },
                "source_type": {
                  "type": "string"
                },
                "sale_unit": {
                  "type": "string",
                  "enum": [
                    "piece",
                    "gram"
                  ],
                  "default": "piece"
                }
              },
              "required": [
                "product_id",
                "product_name",
                "price",
                "quantity",
                "subtotal"
              ]
            }
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "started_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "opened_by": {
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          },
          "checkout_key": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "revision",
          "state",
          "items",
          "total",
          "started_at"
        ]
      },
      "default": []
    },
    "restaurant_outdoor_polygon": {
      "type": "array",
      "description": "Admin chizgan ko\u2018cha/terassa hududi chegarasi, xaritada 0\u20131000 koordinatalar; bo\u2018sh ro\u2018yxat = hali belgilanmagan",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "default": []
    },
    "restaurant_table_layout_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Stollar joylashuvi versiyasi; bir vaqtda tahrirlash nazorati"
    },
    "restaurant_table_layout": {
      "type": "array",
      "description": "Stollarning do\u2018kon bo\u2018yicha 0\u20131000 koordinatadagi joylashuvi",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "x": {
            "type": "integer",
            "minimum": 60,
            "maximum": 940
          },
          "y": {
            "type": "integer",
            "minimum": 70,
            "maximum": 930
          },
          "size": {
            "type": "integer",
            "minimum": 80,
            "maximum": 140,
            "description": "Stolning xaritadagi individual o\u2018lchami foizda; eski stollar 100%"
          }
        },
        "required": [
          "number",
          "x",
          "y"
        ]
      },
      "default": []
    },
    "instagram": {
      "type": "string",
      "description": "Ushbu do\u2018konning chekida ko\u2018rsatiladigan Instagram username"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "id": "{{user.data.shop_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}