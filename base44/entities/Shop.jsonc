{
  "name": "Shop",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "address": {
      "type": "string"
    },
    "allows_pos": {
      "default": true,
      "type": "boolean"
    },
    "is_main": {
      "default": false,
      "type": "boolean"
    },
    "location_type": {
      "default": "shop",
      "enum": [
        "shop",
        "production"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "id": "{{user.data.shop_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}