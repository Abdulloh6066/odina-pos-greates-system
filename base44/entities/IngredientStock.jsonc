{
  "name": "IngredientStock",
  "type": "object",
  "properties": {
    "ingredient_id": {
      "type": "string"
    },
    "ingredient_name": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "low_stock_level": {
      "default": 0,
      "type": "number"
    },
    "quantity": {
      "default": 0,
      "type": "number"
    },
    "unit": {
      "enum": [
        "g",
        "ml",
        "piece"
      ],
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    },
    "ingredient_request_operations_json": {
      "type": "string",
      "default": "",
      "description": "Durable receipt and transfer markers written atomically with the balance."
    }
  },
  "required": [
    "location_id",
    "ingredient_id",
    "ingredient_name",
    "unit",
    "quantity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "data.location_id": "{{user.data.shop_id}}"
                }
              ]
            },
            {
              "$or": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "manager",
                        "active": true
                      }
                    },
                    {
                      "data.location_id": {
                        "$nin": [
                          "",
                          null
                        ]
                      }
                    },
                    {
                      "data.location_id": "{{user.data.shop_id}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
