{
  "name": "ProductStock",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "low_stock_level": {
      "default": 0,
      "type": "number"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity": {
      "default": 0,
      "type": "number"
    },
    "unit": {
      "default": "piece",
      "enum": [
        "piece",
        "sheet"
      ],
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    },
    "wholesale_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wholesale sale IDs committed atomically with stock deductions."
    },
    "transfer_receipts_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backend operation markers committed atomically with receipt deltas."
    },
    "transfer_receipts_reversed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backend markers for exactly-once receipt recovery."
    }
  },
  "required": [
    "location_id",
    "product_id",
    "product_name",
    "unit",
    "quantity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "data.location_id": "{{user.data.shop_id}}"
                }
              ]
            },
            {
              "$or": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "manager",
                        "active": true
                      }
                    },
                    {
                      "data.location_id": {
                        "$nin": [
                          "",
                          null
                        ]
                      }
                    },
                    {
                      "data.location_id": "{{user.data.shop_id}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}