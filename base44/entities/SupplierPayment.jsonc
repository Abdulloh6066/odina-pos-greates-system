{
  "name": "SupplierPayment",
  "type": "object",
  "properties": {
    "payment_number": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "receipt_number_snapshot": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name_snapshot": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name_snapshot": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "cash_movement_id": {
      "type": "string"
    },
    "payment_source": {
      "type": "string",
      "enum": [
        "shift_cash",
        "budget"
      ],
      "default": "shift_cash"
    },
    "budget_account": {
      "type": "string",
      "enum": [
        "cash",
        "uzcard",
        "humo",
        "online",
        "bank"
      ]
    },
    "budget_transaction_id": {
      "type": "string"
    },
    "authorized_by_id": {
      "type": "string"
    },
    "authorized_by_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "payment_number",
    "receipt_id",
    "supplier_id",
    "supplier_name_snapshot",
    "amount",
    "shop_id",
    "shift_id",
    "user_id",
    "paid_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "data.payment_source": {
                    "$ne": "budget"
                  }
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "warehouse"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "$and": [
                        {
                          "$nor": [
                            {
                              "user_condition": {
                                "role": "manager"
                              }
                            }
                          ]
                        },
                        {
                          "data.user_id": "{{user.id}}"
                        }
                      ]
                    },
                    {
                      "$and": [
                        {
                          "user_condition": {
                            "role": "manager",
                            "active": true
                          }
                        },
                        {
                          "data.shop_id": {
                            "$nin": [
                              "",
                              null
                            ]
                          }
                        },
                        {
                          "data.shop_id": "{{user.data.shop_id}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
