{
  "name": "Product",
  "properties": {
    "available_shop_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Bo\u2018sh bo\u2018lsa barcha do\u2018konlarda, aks holda faqat sanalgan do\u2018konlarda sotiladi"
    },
    "display_before_product_id": {
      "type": "string",
      "description": "Kassada shu mahsulotdan oldin ko\u2018rsatish"
    },
    "production_unit": {
      "type": "string",
      "enum": [
        "piece",
        "sheet"
      ],
      "default": "piece"
    },
    "pieces_per_sheet": {
      "type": "integer",
      "minimum": 1,
      "default": 20
    },
    "sheet_price": {
      "type": "number",
      "minimum": 0
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "shop_category_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Do\u2018kon ID bo\u2018yicha kassadagi kategoriya; belgilanmasa umumiy category_id ishlatiladi"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "pos_thumbnail_url": {
      "type": "string",
      "description": "Kassa uchun kichraytirilgan WebP rasm manzili; asl image_url o\u2018zgartirilmaydi"
    },
    "pos_thumbnail_source": {
      "type": "string",
      "description": "pos_thumbnail_url qaysi image_url dan tayyorlanganini ko\u2018rsatadi; mos kelmasa kassa asl rasmni ishlatadi"
    },
    "is_favorite": {
      "default": false,
      "type": "boolean"
    },
    "favorite_shop_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Do\u2018kon bo\u2018yicha sevimli mahsulotlar"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "shop_prices": {
      "type": "object",
      "description": "Do\u2018kon ID bo\u2018yicha alohida sotuv narxlari; qolgan do\u2018konlar asosiy narxdan foydalanadi"
    },
    "source_type": {
      "default": "central_produced",
      "enum": [
        "central_produced",
        "shop_prepared",
        "resale"
      ],
      "type": "string"
    },
    "stock_unit": {
      "default": "piece",
      "enum": [
        "piece"
      ],
      "type": "string"
    },
    "track_stock": {
      "default": true,
      "type": "boolean"
    },
    "last_production_cost": {
      "type": "number",
      "default": 0,
      "description": "Oxirgi ishlab chiqarishdagi 1 natija birligi tannarxi"
    },
    "sale_unit": {
      "type": "string",
      "enum": [
        "piece",
        "gram"
      ],
      "default": "piece"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  },
  "type": "object"
}