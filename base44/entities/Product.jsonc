{
  "name": "Product",
  "properties": {
    "production_unit": {
      "type": "string",
      "enum": [
        "piece",
        "sheet"
      ],
      "default": "piece"
    },
    "pieces_per_sheet": {
      "type": "integer",
      "minimum": 1,
      "default": 20
    },
    "sheet_price": {
      "type": "number",
      "minimum": 0
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_favorite": {
      "default": false,
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "source_type": {
      "default": "central_produced",
      "enum": [
        "central_produced",
        "shop_prepared",
        "resale"
      ],
      "type": "string"
    },
    "stock_unit": {
      "default": "piece",
      "enum": [
        "piece"
      ],
      "type": "string"
    },
    "track_stock": {
      "default": true,
      "type": "boolean"
    },
    "last_production_cost": {
      "type": "number",
      "default": 0,
      "description": "Oxirgi ishlab chiqarishdagi 1 natija birligi tannarxi"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  },
  "type": "object"
}