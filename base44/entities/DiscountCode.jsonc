{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "percentage": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "single_use": {
      "type": "boolean",
      "default": true
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "used_by_sale_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "percentage"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}