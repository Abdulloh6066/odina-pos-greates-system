{
  "name": "SaleItem",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "sale_number": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "cashier_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "source_type_snapshot": {
      "type": "string"
    },
    "stock_tracked_snapshot": {
      "type": "boolean",
      "default": false
    },
    "stock_location_id": {
      "type": "string"
    },
    "stock_quantity_change": {
      "type": "number",
      "default": 0
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "image_url_snapshot": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number"
    },
    "unit_cost_at_sale": {
      "type": "number",
      "default": 0,
      "description": "Sotuv vaqtidagi o\u2018zgartirib bo\u2018lmaydigan tannarx (1 dona)"
    },
    "total_cost_at_sale": {
      "type": "number",
      "default": 0,
      "description": "Sotuv vaqtidagi qator tannarxi = unit_cost_at_sale * quantity"
    },
    "cost_is_estimate": {
      "type": "boolean",
      "default": true,
      "description": "Tannarx ishonchli hisoblanmagan (retsept/xarid narxi yetishmagan) \u2014 Taxminiy"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sale_unit": {
      "type": "string",
      "enum": [
        "piece",
        "gram"
      ],
      "default": "piece"
    },
    "fries_option": {
      "type": "string",
      "enum": [
        "with",
        "without"
      ],
      "description": "Burger fri tanlovi; eski savdolarda bo\u2018sh qoladi"
    }
  },
  "required": [
    "sale_id",
    "shop_id",
    "shift_id",
    "cashier_id",
    "product_name_snapshot",
    "quantity",
    "unit_price",
    "line_total"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "data.cashier_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}