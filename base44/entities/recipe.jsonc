{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1
    },
    "output_quantity": {
      "type": "number",
      "default": 1
    },
    "output_unit": {
      "type": "string",
      "enum": [
        "piece",
        "sheet"
      ],
      "default": "piece"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "product_name_snapshot",
    "version",
    "output_quantity",
    "output_unit",
    "active",
    "created_at",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}