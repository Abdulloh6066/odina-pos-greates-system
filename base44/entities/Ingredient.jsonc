{
  "name": "Ingredient",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "base_unit": {
      "enum": [
        "g",
        "ml",
        "piece"
      ],
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "packaging",
        "household"
      ]
    },
    "conversion_to_base": {
      "default": 1,
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "purchase_unit": {
      "enum": [
        "kg",
        "l",
        "g",
        "ml",
        "piece"
      ],
      "type": "string"
    },
    "is_cake_layer": {
      "type": "boolean",
      "default": false,
      "description": "Pishirilgan biskvit/korj qavati. Markaziy ishlab chiqarishda butun list/qavat soni bilan yuritiladi; asosiy va xarid birligi piece."
    },
    "preparation_shop_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Do\u2018konda tayyorlash yoqilgan joylar."
    },
    "preparation_recipe": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "boolean",
          "default": false
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "output_quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "output_unit": {
          "type": "string",
          "enum": [
            "g",
            "ml",
            "piece"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredient_id": {
                "type": "string"
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "enum": [
                  "g",
                  "ml",
                  "piece"
                ]
              }
            },
            "required": [
              "ingredient_id",
              "quantity",
              "unit"
            ]
          }
        }
      },
      "required": [
        "confirmed",
        "version",
        "output_quantity",
        "output_unit",
        "items"
      ],
      "description": "Tasdiqlangan chiqish miqdori va asosiy birlikdagi masalliqlar. Chiqish miqdori taxmin qilinmaydi."
    }
  },
  "required": [
    "name",
    "category",
    "base_unit",
    "purchase_unit",
    "conversion_to_base"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        },
        {
          "user_condition": {
            "role": "warehouse"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  },
  "type": "object"
}