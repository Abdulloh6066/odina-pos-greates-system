{
  "name": "Settings",
  "type": "object",
  "properties": {
    "customer_order_last_number": {
      "type": "integer",
      "minimum": 0,
      "description": "Buyurtmalarning doimiy umumiy raqami uchun server hisoblagichi; kun almashganda nolga tushmaydi."
    },
    "shop_name": {
      "type": "string",
      "default": "Odina Shop"
    },
    "thank_you_message": {
      "type": "string"
    },
    "receipt_footer": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "UZS"
    },
    "allow_negative_stock": {
      "type": "boolean",
      "default": true,
      "description": "Qoldiq yetishmasa ogohlantirib sotishga ruxsat"
    }
  },
  "required": [
    "shop_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "production"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}