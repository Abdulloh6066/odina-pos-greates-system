{
  "name": "StockTransfer",
  "type": "object",
  "properties": {
    "transfer_number": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "line_number": {
      "type": "integer"
    },
    "batch_item_count": {
      "type": "integer"
    },
    "source_location_id": {
      "type": "string"
    },
    "source_location_name": {
      "type": "string"
    },
    "destination_location_id": {
      "type": "string"
    },
    "destination_location_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name_snapshot": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "enum": [
        "piece",
        "sheet"
      ],
      "default": "piece"
    },
    "received_quantity": {
      "type": "number",
      "minimum": 1
    },
    "conversion_factor": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "receiving",
        "received"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_by": {
      "type": "string"
    },
    "received_by_name": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "transfer_number",
    "source_location_id",
    "source_location_name",
    "destination_location_id",
    "destination_location_name",
    "product_id",
    "product_name_snapshot",
    "quantity",
    "unit",
    "status",
    "created_by",
    "created_by_name",
    "sent_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "data.source_location_id": "{{user.data.shop_id}}"
                },
                {
                  "data.destination_location_id": "{{user.data.shop_id}}"
                }
              ]
            },
            {
              "$or": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "manager",
                        "active": true
                      }
                    },
                    {
                      "$or": [
                        {
                          "$and": [
                            {
                              "data.source_location_id": {
                                "$nin": [
                                  "",
                                  null
                                ]
                              }
                            },
                            {
                              "data.source_location_id": "{{user.data.shop_id}}"
                            }
                          ]
                        },
                        {
                          "$and": [
                            {
                              "data.destination_location_id": {
                                "$nin": [
                                  "",
                                  null
                                ]
                              }
                            },
                            {
                              "data.destination_location_id": "{{user.data.shop_id}}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
