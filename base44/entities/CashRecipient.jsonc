{
  "name": "CashRecipient",
  "properties": {
    "name": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "company",
        "supplier"
      ],
      "default": "supplier"
    },
    "notes": {
      "type": "string"
    },
    "supplied_ingredient_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Yetkazib beruvchiga biriktirilgan masalliq va qadoq IDlari; bo\u2018sh ro\u2018yxat yangi xarid kirimlarini cheklaydi."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "recipient_type",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        },
        {
          "user_condition": {
            "role": "warehouse"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}