{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "maxLength": 120,
      "description": "Egasi/Admin tanlagan xodim ismi. Email va kirish hisobidagi ismni o\u2018zgartirmaydi."
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "cashier",
        "accountant",
        "production",
        "warehouse"
      ],
      "default": "cashier"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_owner": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "is_owner": true
      }
    },
    "delete": {
      "user_condition": {
        "is_owner": true
      }
    }
  }
}