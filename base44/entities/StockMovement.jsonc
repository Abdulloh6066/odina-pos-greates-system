{
  "name": "StockMovement",
  "properties": {
    "balance_after": {
      "type": "number"
    },
    "balance_before": {
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_kind": {
      "enum": [
        "ingredient",
        "product"
      ],
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "movement_number": {
      "type": "string"
    },
    "movement_type": {
      "enum": [
        "opening",
        "adjustment",
        "receipt",
        "production_use",
        "production_output",
        "transfer_out",
        "transfer_in",
        "sale",
        "waste",
        "waste_cancel",
        "refund",
        "receipt_cancel"
      ],
      "type": "string"
    },
    "quantity_change": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "reference_type": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number_snapshot": {
      "type": "string"
    },
    "unit": {
      "enum": [
        "g",
        "ml",
        "piece",
        "sheet"
      ],
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "preparation_snapshot": {
      "type": "object",
      "description": "Tayyorlash paytidagi tasdiqlangan retsept va haqiqiy sarfning o\u2018zgarmas nusxasi.",
      "properties": {
        "recipe_version": {
          "type": "integer"
        },
        "recipe_output_quantity": {
          "type": "number"
        },
        "recipe_output_unit": {
          "type": "string"
        },
        "prepared_quantity": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredient_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "recipe_quantity": {
                "type": "number"
              },
              "used_quantity": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "movement_number",
    "location_id",
    "item_kind",
    "item_id",
    "item_name",
    "unit",
    "movement_type",
    "quantity_change",
    "balance_before",
    "balance_after",
    "reason",
    "user_id",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "data.location_id": "{{user.data.shop_id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.location_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.location_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}