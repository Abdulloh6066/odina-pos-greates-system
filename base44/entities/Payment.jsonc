{
  "name": "Payment",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "sale_number": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "cashier_id": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_card",
        "online",
        "uzcard",
        "humo",
        "click",
        "payme",
        "bank_transfer",
        "other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "reference": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sale_id",
    "shop_id",
    "shift_id",
    "cashier_id",
    "method",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$nor": [
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "accountant"
                  }
                },
                {
                  "data.cashier_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "manager",
                "active": true
              }
            },
            {
              "data.shop_id": {
                "$nin": [
                  "",
                  null
                ]
              }
            },
            {
              "data.shop_id": "{{user.data.shop_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
