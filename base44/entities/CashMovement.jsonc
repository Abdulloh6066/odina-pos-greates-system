{
  "name": "CashMovement",
  "properties": {
    "amount": {
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "expense_category": {
      "default": "other_expense",
      "enum": [
        "shop_expense",
        "goods_payment",
        "owner_withdrawal",
        "other_expense"
      ],
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name_snapshot": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "reference_type": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "type": {
      "default": "withdrawal",
      "enum": [
        "withdrawal"
      ],
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "shop_id",
    "user_id",
    "employee_name",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "data.user_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}