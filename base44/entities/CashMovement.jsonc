{
  "name": "CashMovement",
  "properties": {
    "amount": {
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "expense_category": {
      "default": "other_expense",
      "enum": [
        "shop_expense",
        "goods_payment",
        "owner_withdrawal",
        "other_expense"
      ],
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name_snapshot": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "reference_type": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "shop_id": {
      "type": "string"
    },
    "type": {
      "default": "withdrawal",
      "enum": [
        "withdrawal"
      ],
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "shift_id",
    "shop_id",
    "user_id",
    "employee_name",
    "type",
    "amount",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}