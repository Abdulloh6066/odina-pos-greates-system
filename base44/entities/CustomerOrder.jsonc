{
  "name": "CustomerOrder",
  "type": "object",
  "properties": {
    "order_sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Mijozga ko‘rsatiladigan o‘zgarmas tartib raqami: 1, 2, 3... barcha kunlar va do‘konlar bo‘yicha."
    },
    "order_number": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "toy_va_bazmlar",
        "tugilgan_kun_va_boshqa"
      ]
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name_snapshot": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Bog'langan mijoz (Customer) yozuvi IDsi"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "required_date": {
      "type": "string",
      "format": "date"
    },
    "required_time": {
      "type": "string"
    },
    "fulfilment_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery"
      ]
    },
    "delivery_address": {
      "type": "string"
    },
    "reference_image": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "cake_shape": {
      "type": "string"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "adjustment_amount": {
      "type": "number",
      "default": 0
    },
    "adjustment_reason": {
      "type": "string"
    },
    "original_calculated_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "remaining_balance": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "qabul_qilindi",
        "tayyorlanmoqda",
        "tayyor",
        "yuborildi_olib_ketildi",
        "yakunlandi",
        "bekor_qilindi"
      ],
      "default": "qabul_qilindi"
    },
    "ready_at": {
      "type": "string",
      "format": "date-time"
    },
    "ready_inventory_state": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed"
      ],
      "default": "pending"
    },
    "ready_inventory_token": {
      "type": "string"
    },
    "ready_inventory_location_id": {
      "type": "string"
    },
    "ready_inventory_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_role": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_fingerprint": {
      "type": "string",
      "description": "Server fingerprint binding the creation request to its actor and payload."
    },
    "creation_state": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "description": "Creation is confirmed only after immutable items and advance accounting are saved."
    },
    "creation_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "payment_operation_key": {
      "type": "string"
    },
    "payment_operation_phase": {
      "type": "string",
      "enum": [
        "claimed",
        "ledger_writing",
        "completed"
      ]
    },
    "payment_operation_payload": {
      "type": "object",
      "description": "Server-only frozen payment recovery intent."
    },
    "payment_applied_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_key": {
      "type": "string"
    },
    "completion_fingerprint": {
      "type": "string"
    },
    "completion_phase": {
      "type": "string",
      "enum": [
        "claimed",
        "stock_writing",
        "completed"
      ]
    },
    "creation_advance_shift_id": {
      "type": "string",
      "description": "Server snapshot of the shift selected when the order advance was accepted; retries never move it to a later shift."
    }
  },
  "required": [
    "order_number",
    "order_type",
    "shop_id",
    "customer_name",
    "customer_phone",
    "required_date",
    "required_time",
    "fulfilment_type",
    "subtotal",
    "total",
    "paid_amount",
    "remaining_balance",
    "payment_status",
    "order_status",
    "creator_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.shop_id": "{{user.data.shop_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            },
            {
              "user_condition": {
                "role": "cashier"
              }
            },
            {
              "user_condition": {
                "role": "accountant"
              }
            },
            {
              "user_condition": {
                "role": "production"
              }
            },
            {
              "user_condition": {
                "role": "warehouse"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "accountant"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "production"
                      }
                    },
                    {
                      "data.shop_id": "{{user.data.shop_id}}"
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "manager",
                    "active": true
                  }
                },
                {
                  "data.shop_id": {
                    "$nin": [
                      "",
                      null
                    ]
                  }
                },
                {
                  "data.shop_id": "{{user.data.shop_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
